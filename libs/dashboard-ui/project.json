{
  "name": "@openspawn/dashboard-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/dashboard-ui/src",
  "projectType": "library",
  "targets": {
    "lint": {
      "command": "oxlint libs/dashboard-ui/"
    },
    "typecheck": {
      "command": "tsc --noEmit -p libs/dashboard-ui/tsconfig.json",
      "dependsOn": ["^typecheck"],
      "cache": true,
      "inputs": [
        "{projectRoot}/package.json",
        "{workspaceRoot}/tsconfig.base.json",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/src/**/*.tsx",
        "^default"
      ]
    }
  },
  "tags": [],
  "implicitDependencies": ["shared-types"]
}
