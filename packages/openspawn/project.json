{
  "name": "openspawn",
  "root": "packages/openspawn",
  "sourceRoot": "packages/openspawn/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/openspawn/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config packages/openspawn/vitest.config.ts"
      }
    }
  }
}
