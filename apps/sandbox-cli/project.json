{
  "name": "sandbox-cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/sandbox-cli/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash apps/sandbox-cli/build.sh"
      },
      "outputs": ["{workspaceRoot}/dist/apps/sandbox-cli"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx apps/sandbox-cli/src/main.ts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config apps/sandbox-cli/vitest.config.ts"
      }
    }
  }
}
